{
  "name": "bme-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source studio for Bosch BME690/BME688 gas sensor data: import, explore, label, train and run models in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "umap-js": "^1.4.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
