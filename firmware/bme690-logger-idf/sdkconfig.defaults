# Console on UART0 (the DevKitC "UART" port) and mirrored to the native
# USB serial/JTAG port, so output appears on whichever port is plugged in.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Every DevKitC-1 has at least 8 MB of flash. Two 1.9 MB app slots for
# over-the-air updates (partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A new firmware that fails to start properly is rolled back at the next
# boot; main.c confirms a good start.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The compensation path is double-precision in Bosch's reference; keep printf
# able to render it.
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y

CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000

# Dashboard live data.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Long file names on the card (s0007_0000.bmerawdata).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Startup builds the first recording header on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
