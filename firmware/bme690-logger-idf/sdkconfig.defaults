# ESP32-S3, native USB serial/JTAG for the console so no UART bridge is needed.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The compensation path is double-precision in Bosch's reference; keep printf
# able to render it.
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y

CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000
