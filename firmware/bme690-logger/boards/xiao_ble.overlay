/*
 * Seeed XIAO nRF52840 + BME690 8x Shuttle Board 3.0.
 *
 * Pin budget is exact: D8-D10 carry SPI, D0-D7 are the eight chip selects.
 *
 *   shuttle Row 1 pin 1  Vdd     -> 3V3
 *   shuttle Row 1 pin 2  VddIO   -> 3V3
 *   shuttle Row 1 pin 3  Gnd     -> GND
 *   shuttle Row 2 pin 2  SCK     -> D8  (P1.13)
 *   shuttle Row 2 pin 3  SDO     -> D9  (P1.14)  sensor out, MCU MISO
 *   shuttle Row 2 pin 4  SDI     -> D10 (P1.15)  sensor in,  MCU MOSI
 *
 *   sensor 0  Row 1 pin 4  GPIO0 -> D0 (P0.02)
 *   sensor 1  Row 1 pin 5  GPIO1 -> D1 (P0.03)
 *   sensor 2  Row 1 pin 6  GPIO2 -> D2 (P0.28)
 *   sensor 3  Row 1 pin 7  GPIO3 -> D3 (P0.29)
 *   sensor 4  Row 2 pin 5  GPIO4 -> D4 (P0.04)
 *   sensor 5  Row 2 pin 6  GPIO5 -> D5 (P0.05)
 *   sensor 6  Row 2 pin 7  GPIO6 -> D6 (P1.11)
 *   sensor 7  Row 2 pin 8  GPIO7 -> D7 (P1.12)
 */

&spi2 {
	status = "okay";
	cs-gpios = <&gpio0 2  GPIO_ACTIVE_LOW>;
};

/ {
	bme690_shuttle: bme690-shuttle {
		compatible = "gpio-keys";   /* convenient container for a gpio list */
		cs0: cs_0 { gpios = <&gpio0 2  GPIO_ACTIVE_LOW>; label = "sensor0"; };
		cs1: cs_1 { gpios = <&gpio0 3  GPIO_ACTIVE_LOW>; label = "sensor1"; };
		cs2: cs_2 { gpios = <&gpio0 28 GPIO_ACTIVE_LOW>; label = "sensor2"; };
		cs3: cs_3 { gpios = <&gpio0 29 GPIO_ACTIVE_LOW>; label = "sensor3"; };
		cs4: cs_4 { gpios = <&gpio0 4  GPIO_ACTIVE_LOW>; label = "sensor4"; };
		cs5: cs_5 { gpios = <&gpio0 5  GPIO_ACTIVE_LOW>; label = "sensor5"; };
		cs6: cs_6 { gpios = <&gpio1 11 GPIO_ACTIVE_LOW>; label = "sensor6"; };
		cs7: cs_7 { gpios = <&gpio1 12 GPIO_ACTIVE_LOW>; label = "sensor7"; };
	};
};
